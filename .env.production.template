# ============================================================================
# NFT MARKETPLACE - PRODUCTION ENVIRONMENT
# ============================================================================
# 🚀 PRODUCTION DEPLOYMENT CONFIGURATION
# ⚠️ CRITICAL: Double-check all values before deploying to production!
# ============================================================================

# ============================================================================
# DATABASE (Production MongoDB Atlas)
# ============================================================================
MONGODB_URI=mongodb+srv://prod_user:STRONG_PASSWORD@production-cluster.mongodb.net/production_db?retryWrites=true&w=majority
MONGODB_DB=IdeationMarket_Production

# ============================================================================
# REDIS (Recommended for Multi-Instance Scaling)
# ============================================================================
# Shared API cache and distributed rate limiting across all app instances.
REDIS_URL=rediss://default:REPLACE_WITH_PRODUCTION_REDIS_PASSWORD@your-redis-host:6379
REDIS_DISABLED=false
REDIS_SSE_CHANNEL=marketplace:sse:events:<env>

# ============================================================================
# SECURITY (Production Secrets)
# ============================================================================
# 🔐 CRITICAL: Use strong, unique secrets for production!
JWT_SECRET=__REPLACE_WITH_PRODUCTION_SECRET_MIN_64_CHARS__

# ============================================================================
# BLOCKCHAIN RPC (Production-Grade Providers)
# ============================================================================
# Server-Side (High Rate Limits)
JSON_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/PRODUCTION_ALCHEMY_KEY
ALCHEMY_URL=https://eth-sepolia.g.alchemy.com/v2/PRODUCTION_ALCHEMY_KEY
ALCHEMY_URL_WSS=wss://eth-sepolia.g.alchemy.com/v2/PRODUCTION_ALCHEMY_KEY
INFURA_URL=https://sepolia.infura.io/v3/PRODUCTION_INFURA_KEY
INFURA_URL_WSS=wss://sepolia.infura.io/ws/v3/PRODUCTION_INFURA_KEY

# Client-Side (Rate-Limited in Provider Dashboard)
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/PUBLIC_ALCHEMY_KEY
NEXT_PUBLIC_ALCHEMY_URL_WSS=wss://sepolia.infura.io/ws/v3/PUBLIC_INFURA_KEY
NEXT_PUBLIC_INFURA_URL_WSS=wss://sepolia.infura.io/ws/v3/PUBLIC_INFURA_KEY
NEXT_PUBLIC_ALCHEMY_API_KEY=PUBLIC_ALCHEMY_KEY
NEXT_PUBLIC_INFURA_API_KEY=PUBLIC_INFURA_KEY

# ============================================================================
# WALLET CONNECT
# ============================================================================
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=production_walletconnect_project_id
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=production_walletconnect_project_id

# ============================================================================
# SMART CONTRACTS (Production Addresses)
# ============================================================================
NEXT_PUBLIC_MARKETPLACE_ADDRESS=0xProductionMarketplaceAddressHere
NEXT_PUBLIC_MULTISIG_WALLET_ADDRESS=0xProductionMultiSigAddressHere

# ============================================================================
# THE GRAPH (Production Subgraph)
# ============================================================================
NEXT_PUBLIC_SUBGRAPH_VERSION=v2
NEXT_PUBLIC_SUBGRAPH_V2_URL=https://api.studio.thegraph.com/query/46078/ideation-market-prod/version/latest
NEXT_PUBLIC_SUBGRAPH_V2_DEPLOY_KEY=production_deploy_key
NEXT_PUBLIC_SUBGRAPH_URL=https://api.studio.thegraph.com/query/46078/ideation-market-prod/version/latest
USE_GRAPH_SUBSCRIPTIONS=false

# ============================================================================
# EXCHANGE RATES (Production Configuration)
# ============================================================================
NEXT_PUBLIC_COINBASE_API_URL=https://api.coinbase.com/v2/exchange-rates
NEXT_PUBLIC_CRYPTOCOMPARE_API_URL=https://min-api.cryptocompare.com/data/pricemulti
NEXT_PUBLIC_EXCHANGE_RATE_CACHE_HOURS=24
NEXT_PUBLIC_EXCHANGE_RATE_UPDATE_INTERVAL_HOURS=6
NEXT_PUBLIC_CURRENCY_DEBUG_MODE=false

# 1inch DEX Aggregation (server-side only)
ONEINCH_API_KEY=production_1inch_api_key
# Optional fallback variable name (legacy)
# ONE_INCH_API_KEY=production_1inch_api_key

# ============================================================================
# ACCESS CONTROL (Production Admins)
# ============================================================================
NEXT_PUBLIC_INSIGHTS_ADMIN_ADDRESSES=0xProdAdmin1,0xProdAdmin2,0xProdAdmin3
NEXT_PUBLIC_INSIGHTS_READ_ONLY_MODE=false
NEXT_PUBLIC_APP_LOCK_ENABLED=false

# ============================================================================
# EXTERNAL APIS (Production Keys)
# ============================================================================
GOOGLE_API_KEY=production_google_api_key

# ============================================================================
# DEPLOYMENT CONFIGURATION
# ============================================================================
NODE_ENV=production
NEXT_SHARP_PATH=/tmp/node_modules/sharp
NEXT_PUBLIC_APP_NAME=IdeationMarket

# ============================================================================
# 🔒 PRODUCTION SECURITY CHECKLIST
# ============================================================================
# Before going live:
# ✓ All secrets are production-grade (64+ characters)
# ✓ API keys have rate limits enabled
# ✓ Admin addresses are verified and checksummed
# ✓ Database has backups enabled
# ✓ MongoDB IP whitelist is configured
# ✓ All NEXT_PUBLIC_ vars contain no secrets
# ✓ Subgraph is deployed to decentralized network
# ✓ Smart contracts are verified on Etherscan
# ============================================================================
