# ============================================================================
# NFT MARKETPLACE - ENVIRONMENT CONFIGURATION
# ============================================================================
# 🔒 SECURITY: Never commit .env.local to git!
# 📋 SETUP: Copy this file to .env.local and fill in your values
# ============================================================================

# ============================================================================
# 1️⃣ DATABASE CONFIGURATION (Server-Side Only)
# ============================================================================
# MongoDB Atlas Connection String
# ⚠️ CRITICAL: Keep this secret! Contains credentials.
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority&appName=ClusterName
MONGODB_DB=Ideationmarket_v2

# ============================================================================
# 1️⃣b REDIS (Optional - Recommended for Multi-Instance Scaling)
# ============================================================================
# Enables shared API cache + distributed rate limiting across multiple app instances.
# Example (Upstash/Redis Cloud): rediss://default:password@host:port
REDIS_URL=

# Emergency switch: disable Redis integration without removing REDIS_URL
REDIS_DISABLED=false

# Optional: SSE Pub/Sub channel name (only needed for custom namespace)
REDIS_SSE_CHANNEL=marketplace:sse:events:<env>

# ============================================================================
# 2️⃣ AUTHENTICATION & SECURITY (Server-Side Only)
# ============================================================================
# JWT Secret for session tokens (minimum 32 characters)
# 🔐 Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=__GENERATE_A_LONG_RANDOM_SECRET_HERE__

# ============================================================================
# 3️⃣ BLOCKCHAIN RPC ENDPOINTS
# ============================================================================

# --- Server-Side RPC (Backend Operations - Not exposed to browser) ---
# Primary RPC endpoint for server operations
JSON_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Alchemy HTTP & WebSocket endpoints (Server)
ALCHEMY_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ALCHEMY_URL_WSS=wss://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Infura HTTP & WebSocket endpoints (Server)
INFURA_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
INFURA_URL_WSS=wss://sepolia.infura.io/ws/v3/YOUR_INFURA_KEY

# --- Client-Side RPC (Visible in Browser) ---
# 📖 Note: These are exposed to users - ensure proper rate limiting in provider dashboards
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# WebSocket endpoints for real-time event listening
NEXT_PUBLIC_ALCHEMY_URL_WSS=wss://sepolia.infura.io/ws/v3/YOUR_INFURA_KEY
NEXT_PUBLIC_INFURA_URL_WSS=wss://sepolia.infura.io/ws/v3/YOUR_INFURA_KEY

# API Keys (for direct SDK usage)
NEXT_PUBLIC_ALCHEMY_API_KEY=YOUR_ALCHEMY_KEY
NEXT_PUBLIC_INFURA_API_KEY=YOUR_INFURA_KEY

# ============================================================================
# 4️⃣ WALLET CONNECT INTEGRATION
# ============================================================================
# WalletConnect Cloud Project ID
# 📝 Get yours at: https://cloud.walletconnect.com
# 🔗 Used for: WalletConnect v2, mobile wallet connections
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_walletconnect_project_id_here

# ============================================================================
# 5️⃣ SMART CONTRACT ADDRESSES (Sepolia Testnet)
# ============================================================================
# 💎 Diamond Marketplace Contract
# ⚠️ IMPORTANT: Use Diamond proxy address, NOT individual facet addresses!
NEXT_PUBLIC_MARKETPLACE_ADDRESS=0x1107Eb26D47A5bF88E9a9F97cbC7EA38c3E1D7EC

# 🔐 MultiSig Wallet Contract (Optional - for governance)
NEXT_PUBLIC_MULTISIG_WALLET_ADDRESS=0xYourMultiSigWalletAddressHere

# ============================================================================
# 6️⃣ THE GRAPH SUBGRAPH INDEXING
# ============================================================================
# 📊 Subgraph Version Control
NEXT_PUBLIC_SUBGRAPH_VERSION=v2

# V2 Subgraph (Current - Ideation Market)
# 🔗 Studio URL: https://thegraph.com/studio/subgraph/ideation-market/
NEXT_PUBLIC_SUBGRAPH_V2_URL=https://api.studio.thegraph.com/query/46078/ideation-market/v0.1.2
NEXT_PUBLIC_SUBGRAPH_V2_DEPLOY_KEY=your_deploy_key_here

# Legacy V1 Subgraph (Deprecated - kept for migration)
NEXT_PUBLIC_SUBGRAPH_URL=https://api.studio.thegraph.com/query/46078/ideation-market/v0.1.2

# Subscription Mode (WebSocket-based real-time sync - currently disabled)
USE_GRAPH_SUBSCRIPTIONS=false

# ============================================================================
# 7️⃣ EXCHANGE RATES & PRICING
# ============================================================================
# 💱 External API endpoints for crypto price feeds
NEXT_PUBLIC_COINBASE_API_URL=https://api.coinbase.com/v2/exchange-rates
NEXT_PUBLIC_CRYPTOCOMPARE_API_URL=https://min-api.cryptocompare.com/data/pricemulti

# Cache & Update Configuration
NEXT_PUBLIC_EXCHANGE_RATE_CACHE_HOURS=24
NEXT_PUBLIC_EXCHANGE_RATE_UPDATE_INTERVAL_HOURS=6
NEXT_PUBLIC_CURRENCY_DEBUG_MODE=false

# 1inch DEX Aggregation (server-side only)
# Required for /api/integrations/1inch/quote and /api/integrations/1inch/swap
ONEINCH_API_KEY=your_1inch_api_key_here
# Optional fallback variable name (legacy)
# ONE_INCH_API_KEY=your_1inch_api_key_here

# ============================================================================
# 8️⃣ ACCESS CONTROL & ADMIN CONFIGURATION
# ============================================================================
# 👥 Admin Wallet Addresses (comma-separated, no spaces)
# These addresses have full admin privileges (insights, dashboard, etc.)
NEXT_PUBLIC_INSIGHTS_ADMIN_ADDRESSES=0xAddress1,0xAddress2,0xAddress3,0xAddress4

# Read-Only Mode (disables admin modifications)
NEXT_PUBLIC_INSIGHTS_READ_ONLY_MODE=false

# App-Wide Lock (only admin wallets can access the entire app)
NEXT_PUBLIC_APP_LOCK_ENABLED=false

# ============================================================================
# 9️⃣ EXTERNAL API INTEGRATIONS
# ============================================================================
# Google APIs (for maps, analytics, etc.)
GOOGLE_API_KEY=your_google_api_key_here

# ============================================================================
# 🔟 BUILD & DEPLOYMENT CONFIGURATION
# ============================================================================
# Environment Mode
NODE_ENV=development

# Sharp Image Optimization (for Docker/Railway deployment)
NEXT_SHARP_PATH=/tmp/node_modules/sharp

# App Metadata
NEXT_PUBLIC_APP_NAME=IdeationMarket

# ============================================================================
# 📝 OPTIONAL: LEGACY / DEPRECATED VARIABLES
# ============================================================================
# Keep for backward compatibility - will be removed in future versions
# NEXT_PUBLIC_INSIGHTS_ALLOWED_ADDRESSES=...  # Deprecated: Use ADMIN_ADDRESSES
# NEXT_PUBLIC_SUBGRAPH_WS_URL=...  # Deprecated: WebSocket subscriptions removed
# NEXTAUTH_URL=...  # Not used: No NextAuth integration

# ============================================================================
# ✅ VALIDATION CHECKLIST
# ============================================================================
# Before deploying, verify:
# ✓ MongoDB connection string is correct and secure
# ✓ JWT_SECRET is minimum 32 characters and unique
# ✓ All API keys have proper rate limits configured
# ✓ Wallet addresses are checksummed (correct capitalization)
# ✓ Subgraph URLs match deployed version
# ✓ NEXT_PUBLIC_ variables are safe to expose (no secrets!)
# ============================================================================
